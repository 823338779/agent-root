# Local-development defaults only. Copy to .env and change values when needed.
POSTGRES_PASSWORD=data_agent_local_dev
REDIS_PASSWORD=redis_local_dev
DATA_AGENT_ADMIN_PASSWORD=admin
METRIC_PLATFORM_ADMIN_PASSWORD=admin
OLLAMA_BASE_URL=http://host.docker.internal:11434
DATA_AGENT_PORT=8080
METRIC_PLATFORM_PORT=8090
GIT_SSH_PORT=2222
# dbt-service 单独部署，指标平台通过 HTTP 调用服务；凭据由本机安全环境注入。
DBT_SERVICE_TOKEN=
DBT_SERVICE_BASE_URI=http://host.docker.internal:8000
METRIC_PLATFORM_ACCESS_TOKEN=
