# Local-development defaults only. Copy to .env and change values when needed.
POSTGRES_PASSWORD=data_agent_local_dev
REDIS_PASSWORD=redis_local_dev
DATA_AGENT_ADMIN_PASSWORD=admin
METRIC_PLATFORM_ADMIN_PASSWORD=admin
OLLAMA_BASE_URL=http://host.docker.internal:11434
DATA_AGENT_PORT=8080
METRIC_PLATFORM_PORT=8090
GIT_SSH_PORT=2222
# Host services: load these into their process environments; Compose does not run them.
BRANCH_SERVICE_TOKEN=
DATA_AGENT_DBT_BRANCH_SERVICE_TOKEN=
BRANCH_EVENT_SECRET=
BRANCH_EVENTS_ENABLED=true
BRANCH_POLL_SECONDS=30
BRANCH_PREVIEW_PROFILE_BINDING_ID=
