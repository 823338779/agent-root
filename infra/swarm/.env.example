# Set this to the LAN IPv4 address of the swarm manager. Do not use 127.0.0.1 for a multi-node swarm.
LOCAL_REGISTRY=192.168.1.10:5000
IMAGE_TAG=dev
# 启用前先配置 Agent 项目 repository/binding，并确保容器具备受控 Git 访问身份。
DATA_AGENT_GIT_ENABLED=false
DATA_AGENT_DBT_ENABLED=false
# 以下公开地址须作为 Build-And-Push.ps1 参数传入，不是容器运行时 Vite 配置。
AGENT_PUBLIC_URL=http://192.168.1.10:8080
METRIC_PLATFORM_PUBLIC_URL=http://192.168.1.10:8090
