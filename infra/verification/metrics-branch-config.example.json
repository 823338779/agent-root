{
  "agent": {
    "projectId": "ecommerce_metrics",
    "repositoryId": "agent-admin/metrics",
    "subdir": ".",
    "tokenEnvironment": "DATA_AGENT_DBT_BRANCH_SERVICE_TOKEN"
  },
  "service": {
    "projectId": "ecommerce_metrics",
    "repositoryId": "agent-admin/metrics",
    "subdir": ".",
    "eventsEnabled": true,
    "secretEnvironment": "BRANCH_EVENT_SECRET",
    "tokenEnvironment": "BRANCH_SERVICE_TOKEN",
    "capabilities": ["branch-development-v1", "draft-validation-v2"]
  },
  "platform": { "mode": "service-proxy", "legacyPublisherEnabled": false },
  "hooks": [{
    "active": true,
    "url": "http://host.docker.internal:8000/internal/git-branch-events",
    "events": ["push", "delete"],
    "secretEnvironment": "BRANCH_EVENT_SECRET"
  }]
}
